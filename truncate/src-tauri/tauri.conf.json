{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Truncate",
  "version": "0.2.1",
  "identifier": "com.truncate.ide",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Truncate",
        "width": 600,
        "height": 600
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "default",
        "shell-ollama"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "bin/dot-aarch64-apple-darwin",
      "bin/dot-x86_64-unknown-linux-gnu"
    ],
    "externalBin": [
      "binaries/ollama"
    ]
  }
}