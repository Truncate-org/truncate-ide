{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Truncate",
  "version": "0.2.1",
  "identifier": "com.truncate.ide",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Truncate",
        "width": 1000,
        "height": 800,
        "resizable": true,
        "center": true,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "default",
        "shell-ollama"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "bin/dot-aarch64-apple-darwin",
      "bin/dot-x86_64-unknown-linux-gnu"
    ],
    "externalBin": [
      "binaries/ollama"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVBQjA5OUI5ODJDMUI5ODcKUldTSHVjR0N1Wm13Nmkrdk9kOEJ6RDVRa0I1Q3NLdDlKeExqb2pMZjl4bkEvTzBuelJFZ3RBRzIK",
      "endpoints": [
        "https://github.com/Truncate-org/truncate-releases/releases/latest/download/latest.json"
      ]
    }
  }
}