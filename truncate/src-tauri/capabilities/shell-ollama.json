{
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "shell-ollama",
    "description": "Capability to spawn ollama sidecar",
    "windows": [
        "main"
    ],
    "permissions": [
        {
            "identifier": "shell:allow-execute",
            "allow": [
                {
                    "name": "ollama",
                    "cmd": "ollama",
                    "args": [
                        "serve"
                    ],
                    "sidecar": true
                }
            ]
        }
    ]
}