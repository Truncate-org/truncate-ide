#!/bin/bash
# Mock dot binary

output_file=""

# Parse arguments to find -o
while [[ $# -gt 0 ]]; do
  case $1 in
    -o)
      output_file="$2"
      shift # past argument
      shift # past value
      ;;
    *)
      shift # past argument
      ;;
  esac
done

if [ -n "$output_file" ]; then
  # Write a dummy SVG
  echo '<svg width="100" height="100" xmlns="http://www.w3.org/2000/svg"><circle cx="50" cy="50" r="40" stroke="black" stroke-width="3" fill="red" /></svg>' > "$output_file"
else
  echo '<svg width="100" height="100" xmlns="http://www.w3.org/2000/svg"><circle cx="50" cy="50" r="40" stroke="black" stroke-width="3" fill="red" /></svg>'
fi

exit 0
